<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_logo"
    android:padding="24dp">

    <!-- Title Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="40dp">

        <!-- Back Arrow -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button_dialog"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/update_your_status"
            android:textColor="#FF000000"
            android:textSize="24sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Centered Input Fields and Button -->
    <LinearLayout
        android:id="@+id/centerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true"
        android:layout_below="@id/titleTextView"
        android:layout_marginTop="32dp"
        tools:ignore="NotSibling">

        <EditText
            android:id="@+id/classEditText"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:hint="@string/enter_class_name"
            android:inputType="textCapWords"
            android:autofillHints="username"
            android:padding="12dp"
            android:textColor="#FF000000"
            android:textColorHint="#FF424242" />

        <EditText
            android:id="@+id/roomOrLabNumberEditText"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:hint="@string/enter_room_or_lab_number"
            android:inputType="textCapWords|number"
            android:autofillHints="postalAddress"
            android:padding="12dp"
            android:textColor="#FF000000"
            android:textColorHint="#FF424242" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:backgroundTint="@color/midnight_blue"
            android:textColor="@android:color/white"
            android:padding="12dp" />
    </LinearLayout>

    <!-- Message at the Bottom -->
    <TextView
        android:id="@+id/bottomTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manage_classrooms_message"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="50dp" />

</RelativeLayout>